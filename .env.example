# Copiá a apps/api/.env y apps/web/.env.local según corresponda.
# Ver también: apps/api/.env.example y apps/web/.env.example

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
