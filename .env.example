# Trustless Work v2 beta. Empty here. API only, never NEXT_PUBLIC_*.
TRUSTLESS_WORK_API_KEY=
TREASURY_SECRET=
STELLAR_ADMIN_PUBLIC=
NEXT_PUBLIC_API_URL=http://localhost:4000
