# Copiá a apps/api/.env y apps/web/.env.local según corresponda.
# Ver también: apps/api/.env.example y apps/web/.env.example

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Server only, apps/api/.env. Leave empty in git. SESSION_SECRET needs at least 32 characters.
# The SEP10_SIGNING_SECRET account must be different from STELLAR_ADMIN_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SESSION_SECRET=
STELLAR_ADMIN_PUBLIC=
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost
# Trustless Work v2 beta. Empty here. API only, never NEXT_PUBLIC_*.
TRUSTLESS_WORK_API_KEY=
TREASURY_SECRET=
# Secret keys (S…) for the escrow admin and the dispute resolver.
# The operator holds these only in the local env. Never commit them.
# They exist so funded escrows can be updated or a dispute can be resolved.
# Placeholders only. The API derives their public keys at startup.
ESCROW_ADMIN_SECRET=
ESCROW_DISPUTE_RESOLVER_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:4000
