{
  "name": "senda-business",
  "private": true,
  "version": "0.1.0",
  "description": "Senda Business — monorepo with Next.js, Fastify API, and Stellar Soroban contracts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @senda/web",
    "dev:api": "npm run dev -w @senda/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @senda/web",
    "build:api": "npm run build -w @senda/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && cargo test",
    "contracts:build": "stellar contract build",
    "contracts:test": "cargo test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.19.1"
}
