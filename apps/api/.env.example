NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Trustless Work v2 beta (https://beta.api.trustlesswork.com). Empty here.
# Server only: never put this key in the web app or in a log.
TRUSTLESS_WORK_API_KEY=
TREASURY_SECRET=
STELLAR_ADMIN_PUBLIC=
# Secret keys (S…) for the escrow admin and the dispute resolver.
# The operator holds these only in the local env. Never commit them.
# They exist so funded escrows can be updated or a dispute can be resolved.
# Placeholders only. The API derives their public keys at startup.
ESCROW_ADMIN_SECRET=
ESCROW_DISPUTE_RESOLVER_SECRET=
