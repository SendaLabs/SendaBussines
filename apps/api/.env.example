NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Reemplazá estos valores en apps/api/.env. No commitees secretos.
# SEP10_SIGNING_SECRET firma el challenge. En local puede ser la cuenta de tesorería.
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost
# Única cuenta G... que puede entrar al panel.
STELLAR_ADMIN_PUBLIC=
# Mínimo 32 caracteres. Firma la cookie senda_session.
SESSION_SECRET=
