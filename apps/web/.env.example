# Server only. The panel calls GET /business/dashboard on this origin.
# Do not prefix with NEXT_PUBLIC_.
API_URL=http://127.0.0.1:4000
# Same company G account as the API. The form rejects it as a supplier.
# Server only. Do not prefix with NEXT_PUBLIC_.
STELLAR_ADMIN_PUBLIC=

# Placeholders only. The web app does not read these. They belong in apps/api/.env.
# Leave them empty in git. The SEP-10 signing account must differ from STELLAR_ADMIN_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SESSION_SECRET=
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost
TRUSTLESS_WORK_API_KEY=
TREASURY_SECRET=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
